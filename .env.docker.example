# Copie este arquivo para .env.docker e ajuste os valores antes de rodar o Docker Compose.
# O arquivo .env.docker está no .gitignore — nunca commite credenciais reais.
#
#   cp .env.docker.example .env.docker

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=stockwise
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_production

# ── Go API ────────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:change_me_in_production@postgres:5432/stockwise?sslmode=disable
JWT_SECRET=change_me_at_least_32_chars_long_replace_before_deploy
JWT_EXPIRATION_HOURS=24
PORT=8080
ENV=development

# ── DB readiness probe (usado pelo entrypoint.sh) ─────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
